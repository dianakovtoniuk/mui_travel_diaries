# Full MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/travel-diaries
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=5000
# Frontend origin allowed by CORS (comma separated for several)
CLIENT_URL=http://localhost:3000
